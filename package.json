{
  "name": "southern-italy-2026",
  "private": true,
  "version": "1.0.0",
  "description": "A detailed, offline-ready itinerary for Niv and Rinat's Southern Italy road trip in September 2026.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:vibe": "node scripts/vibe-audit.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run audit:vibe && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "suncalc": "^2.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
